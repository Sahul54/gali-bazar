
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  SELLER
  DELIVERY_PARTNER
  ADMIN
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum InventoryMovementType {
  OPENING_STOCK
  RESTOCK
  SALE
  RESERVATION
  RELEASE
  RETURN
  ADJUSTMENT
  DAMAGE
}

model User {
  id           String   @id @default(cuid())
  phone        String   @unique
  name         String?
  email        String?  @unique
  passwordHash String?
  role         UserRole @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  otpVerifications OtpVerification[]
  sellerProfile    SellerProfile?
  deliveryProfile  DeliveryPartnerProfile?

  @@index([role])
}

model OtpVerification {
  id         String    @id @default(cuid())
  phone      String
  otpHash    String
  expiresAt  DateTime
  verifiedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, createdAt])
  @@index([expiresAt])
}

model SellerProfile {
  id           String            @id @default(cuid())
  businessName String
  ownerName    String
  category     String
  address      String
  pincode      String
  status       ApplicationStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[]

  bulkUploads BulkUpload[]
}

enum BulkUploadStatus {
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

model BulkUpload {
  id              String           @id @default(cuid())
  sellerProfileId String
  fileName        String
  totalRows       Int              @default(0)
  importedRows    Int              @default(0)
  failedRows      Int              @default(0)
  status          BulkUploadStatus @default(PROCESSING)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  sellerProfile SellerProfile   @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  rows          BulkUploadRow[]

  @@index([sellerProfileId, createdAt])
  @@index([status])
}

model BulkUploadRow {
  id          String   @id @default(cuid())
  uploadId    String
  rowNumber   Int
  sku         String?
  productName String?
  imported    Boolean  @default(false)
  errors      Json     @default("[]")
  data        Json?
  createdAt   DateTime @default(now())

  upload BulkUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([uploadId, rowNumber])
  @@index([sku])
}

model DeliveryPartnerProfile {
  id          String            @id @default(cuid())
  vehicleType String?
  status      ApplicationStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  products Product[]

  @@index([parentId, isActive])
  @@index([isActive, sortOrder])
}

model Product {
  id          String        @id @default(cuid())
  name        String
  slug        String
  description String?       @db.Text
  brand       String?
  status      ProductStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  sellerProfileId String
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  variants ProductVariant[]
  images   ProductImage[]

  @@unique([sellerProfileId, slug])
  @@index([sellerProfileId, status])
  @@index([categoryId, status])
  @@index([name])
}

model ProductVariant {
  id             String   @id @default(cuid())
  sku            String   @unique
  barcode        String?
  title          String?
  attributes     Json?
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  costPrice      Decimal? @db.Decimal(12, 2)
  weightGrams    Int?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  inventory     Inventory?
  bulkPriceTiers BulkPriceTier[]

  @@index([productId, isActive])
  @@index([barcode])
}

model ProductImage {
  id        String   @id @default(cuid())
  imageUrl  String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model Inventory {
  id                String   @id @default(cuid())
  quantity          Int      @default(0)
  reservedQuantity  Int      @default(0)
  lowStockThreshold Int      @default(10)
  updatedAt         DateTime @updatedAt

  variantId String         @unique
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  movements InventoryMovement[]

  @@index([quantity])
}

model InventoryMovement {
  id        String                @id @default(cuid())
  type      InventoryMovementType
  quantity  Int
  note      String?
  reference String?
  createdAt DateTime              @default(now())

  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  @@index([inventoryId, createdAt])
  @@index([type, createdAt])
}

model BulkPriceTier {
  id          String   @id @default(cuid())
  minQuantity Int
  maxQuantity Int?
  unitPrice   Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, minQuantity])
  @@index([variantId, minQuantity])
}
