generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================== ENUMS ====================

enum UserRole {
  CUSTOMER
  SELLER
  DELIVERY_PARTNER
  ADMIN
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum InventoryMovementType {
  OPENING_STOCK
  RESTOCK
  SALE
  RESERVATION
  RELEASE
  RETURN
  ADJUSTMENT
  DAMAGE
}

enum BulkUploadStatus {
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

enum VehicleType {
  BIKE
  SCOOTER
  MOTORCYCLE
  BICYCLE
  THREE_WHEELER
  OTHER
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  CANCELLED
}

enum DeliveryType {
  EXPRESS
  SCHEDULED
}

enum DeliveryAssignmentStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
  COMPLETED
}

enum DeliveryBatchStatus {
  PENDING
  OFFERED
  ACCEPTED
  PICKING_UP
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
  EXPIRED
}

// ==================== USER & AUTH ====================

model User {
  id           String   @id @default(cuid())
  phone        String   @unique
  name         String?
  email        String?  @unique
  passwordHash String?
  role         UserRole @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  otpVerifications OtpVerification[]
  sellerProfile    SellerProfile?
  deliveryProfile  DeliveryPartnerProfile?
  customerOrders   Order[]
  productViews ProductView[]
  addresses Address[]
  cart Cart?

  // Delivery partner review relations
  reviewedDeliveryApplications DeliveryPartnerProfile[]            @relation("DeliveryPartnerReviewer")
  deliveryPartnerReviewHistory DeliveryPartnerApplicationHistory[] @relation("DeliveryPartnerHistoryReviewer")
  
}

// ==================== OTP ====================

model OtpVerification {
  id         String    @id @default(cuid())
  phone      String
  otpHash    String
  expiresAt  DateTime
  verifiedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, createdAt])
  @@index([expiresAt])
}

// ==================== SELLER ====================

model SellerProfile {
  id           String @id @default(cuid())
  businessName String
  ownerName    String
  category     String
  address      String
  pincode      String

  // Shop location for customer discovery
  latitude  Float?
  longitude Float?

  // Seller approval status
  status ApplicationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Seller account relation
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Product and bulk upload relations
  products    Product[]
  bulkUploads BulkUpload[]

  // Indexes
  @@index([status])
  @@index([pincode, status])
  @@index([latitude, longitude])
}

// ==================== BULK PRODUCT UPLOAD ====================

model BulkUpload {
  id              String           @id @default(cuid())
  sellerProfileId String
  fileName        String
  totalRows       Int              @default(0)
  importedRows    Int              @default(0)
  failedRows      Int              @default(0)
  status          BulkUploadStatus @default(PROCESSING)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  sellerProfile SellerProfile   @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  rows          BulkUploadRow[]

  @@index([sellerProfileId, createdAt])
  @@index([status])
}

model BulkUploadRow {
  id          String   @id @default(cuid())
  uploadId    String
  rowNumber   Int
  sku         String?
  productName String?
  imported    Boolean  @default(false)
  errors      Json     @default("[]")
  data        Json?
  createdAt   DateTime @default(now())

  upload BulkUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([uploadId, rowNumber])
  @@index([sku])
}

// ==================== DELIVERY PARTNER ====================

model DeliveryPartnerProfile {
  id     String            @id @default(cuid())
  status ApplicationStatus @default(PENDING)

  // Vehicle details
  vehicleType   VehicleType?
  vehicleNumber String?
  vehicleModel  String?
  licenseNumber String?

  // Uploaded documents
  licenseDocumentUrl String?
  vehicleDocumentUrl String?

  // Application review details
  rejectionReason String?   @db.Text
  reviewedAt      DateTime?
  reviewedById    String?
  reapplyCount    Int       @default(0)

  reviewedBy User? @relation("DeliveryPartnerReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  // Delivery availability and location
  isOnline            Boolean   @default(false)
  latitude            Float?
  longitude           Float?
  lastLocationAt      DateTime?
  maxDeliveryRadiusKm Float     @default(5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Express delivery relations
  currentOrders Order[]              @relation("CurrentDeliveryPartner")
  assignments   DeliveryAssignment[]

  // Scheduled delivery relation
  deliveryBatches DeliveryBatch[]

  // Application history
  applicationHistory DeliveryPartnerApplicationHistory[]

  @@index([status, isOnline])
  @@index([latitude, longitude])
  @@index([reviewedById])
}

// ==================== DELIVERY PARTNER APPLICATION HISTORY ====================

model DeliveryPartnerApplicationHistory {
  id String @id @default(cuid())

  previousStatus ApplicationStatus?
  newStatus      ApplicationStatus

  // Mandatory for rejection; optional for other transitions
  reason String? @db.Text

  createdAt DateTime @default(now())

  deliveryPartnerProfileId String
  deliveryPartnerProfile   DeliveryPartnerProfile @relation(fields: [deliveryPartnerProfileId], references: [id], onDelete: Cascade)

  // Admin who performed the action
  reviewedById String?
  reviewedBy   User?   @relation("DeliveryPartnerHistoryReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([deliveryPartnerProfileId, createdAt])
  @@index([reviewedById, createdAt])
  @@index([newStatus, createdAt])
}

// ==================== ORDERS ====================

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  status      OrderStatus @default(PLACED)

  customerId String
  customer   User   @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Delivery type
  deliveryType DeliveryType @default(EXPRESS)

  // Scheduled delivery information
  scheduledDate DateTime?
  scheduledSlot String?

  // Seller/store pickup location
  pickupAddress   String?
  pickupLatitude  Float?
  pickupLongitude Float?

  // Customer delivery location
  deliveryAddress   String
  deliveryLatitude  Float?
  deliveryLongitude Float?

  // Order pricing
  subtotal    Decimal @default(0) @db.Decimal(12, 2)
  deliveryFee Decimal @default(0) @db.Decimal(12, 2)
  totalAmount Decimal @default(0) @db.Decimal(12, 2)

  // Currently assigned delivery partner
  assignedDeliveryPartnerId String?
  assignedDeliveryPartner   DeliveryPartnerProfile? @relation("CurrentDeliveryPartner", fields: [assignedDeliveryPartnerId], references: [id], onDelete: SetNull)

  // Order items
  items OrderItem[]

  // Express assignment relation
  assignments DeliveryAssignment[]

  // Scheduled batch relation
  deliveryBatchId String?
  deliveryBatch   DeliveryBatch? @relation(fields: [deliveryBatchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([assignedDeliveryPartnerId, status])
  @@index([pickupLatitude, pickupLongitude])
  @@index([deliveryType, status, scheduledDate])
  @@index([deliveryBatchId])
}

// ==================== EXPRESS DELIVERY ASSIGNMENTS ====================

model DeliveryAssignment {
  id     String                   @id @default(cuid())
  status DeliveryAssignmentStatus @default(PENDING)

  distanceKm    Float?
  attemptNumber Int       @default(1)
  offeredAt     DateTime  @default(now())
  expiresAt     DateTime?
  respondedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  deliveryPartnerProfileId String
  deliveryPartnerProfile   DeliveryPartnerProfile @relation(fields: [deliveryPartnerProfileId], references: [id], onDelete: Restrict)

  @@index([orderId, status])
  @@index([deliveryPartnerProfileId, status])
  @@index([status, expiresAt])
}

// ==================== SCHEDULED DELIVERY BATCHES ====================

model DeliveryBatch {
  id     String              @id @default(cuid())
  status DeliveryBatchStatus @default(PENDING)

  // Batch summary
  totalOrders     Int      @default(0)
  totalEarning    Decimal? @db.Decimal(10, 2)
  totalDistanceKm Float?

  // Offer and acceptance details
  offeredAt   DateTime?
  expiresAt   DateTime?
  acceptedAt  DateTime?
  completedAt DateTime?

  // Assigned delivery partner (optional before assignment)
  partnerProfileId String?
  partnerProfile   DeliveryPartnerProfile? @relation(fields: [partnerProfileId], references: [id], onDelete: Restrict)

  // Orders included in this batch
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerProfileId, status])
  @@index([status, expiresAt])
}

// ==================== CATEGORY ====================

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  products Product[]

  @@index([parentId, isActive])
  @@index([isActive, sortOrder])
}

// ==================== PRODUCTS ====================

model Product {
  id          String        @id @default(cuid())
  name        String
  slug        String
  description String?       @db.Text
  brand       String?
  status      ProductStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  sellerProfileId String
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  variants   ProductVariant[]
  images     ProductImage[]
  orderItems OrderItem[]
  views ProductView[]

  @@unique([sellerProfileId, slug])
  @@index([sellerProfileId, status])
  @@index([categoryId, status])
  @@index([name])
}

model ProductVariant {
  id             String   @id @default(cuid())
  sku            String   @unique
  barcode        String?
  title          String?
  attributes     Json?
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  costPrice      Decimal? @db.Decimal(12, 2)
  weightGrams    Int?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  inventory      Inventory?
  bulkPriceTiers BulkPriceTier[]
  orderItems     OrderItem[]
  cartItems      CartItem[]

  @@index([productId, isActive])
  @@index([barcode])
}

model ProductImage {
  id        String   @id @default(cuid())
  imageUrl  String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

// ==================== INVENTORY ====================

model Inventory {
  id                String   @id @default(cuid())
  quantity          Int      @default(0)
  reservedQuantity  Int      @default(0)
  lowStockThreshold Int      @default(10)
  updatedAt         DateTime @updatedAt

  variantId String         @unique
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  movements InventoryMovement[]

  @@index([quantity])
}

model InventoryMovement {
  id        String                @id @default(cuid())
  type      InventoryMovementType
  quantity  Int
  note      String?
  reference String?
  createdAt DateTime              @default(now())

  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  @@index([inventoryId, createdAt])
  @@index([type, createdAt])
}

// ==================== BULK PRICING ====================

model BulkPriceTier {
  id          String   @id @default(cuid())
  minQuantity Int
  maxQuantity Int?
  unitPrice   Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, minQuantity])
  @@index([variantId, minQuantity])
}

// ==================== ORDER ITEMS ====================

model OrderItem {
  id String @id @default(cuid())

  // Product snapshot
  productName  String
  variantTitle String?
  sku          String

  // Quantity and pricing
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Order relation
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Product relation
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // Product variant relation
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

// ==================== PRODUCT VIEWS ====================

model ProductView {
  id        String   @id @default(cuid())
  viewedAt  DateTime @default(now())

  // Logged-in customer (optional for guest)
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Guest session tracking
  sessionId String?

  // Product relation
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, viewedAt])
  @@index([userId, viewedAt])
  @@index([sessionId, viewedAt])
}

model Address {
  id        String   @id @default(cuid())
  fullName  String
  phone     String
  address   String
  landmark  String?
  city      String
  state     String
  pincode   String
  latitude  Float?
  longitude Float?
  label     String   @default("HOME")
  isDefault Boolean  @default(false)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}


// ==================== CUSTOMER CART ====================

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

// ==================== CART ITEMS ====================

model CartItem {
  id        String   @id @default(cuid())
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartId    String
  variantId String

  cart    Cart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
}
